# Anthropic (chat generation)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI. Only used for reranking (rerank-2) - a single low-volume REST call
# per chat turn (app/services/rerank.py calls Voyage's API directly via httpx).
# Embeddings no longer use Voyage at all; see OPENAI_* below for that.
VOYAGE_API_KEY=pa-...

# OpenAI (embeddings - the only embedding provider now)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Supabase Postgres connection string. Must use the asyncpg-compatible scheme:
# postgresql+asyncpg://
#
# Prefer the Session pooler connection string, not the direct one - Supabase's
# direct host (db.xxxxxxxx.supabase.co) is IPv6-only on the free tier, and
# Docker Desktop containers usually have no IPv6 egress, so a direct connection
# fails with "OSError: [Errno 101] Network is unreachable" the moment the
# backend container starts. The pooler is IPv4-compatible and works from
# Docker. Get it from Supabase project settings -> Database -> Connection
# pooling -> Session mode (port 5432 - not Transaction mode/6543, which
# disables prepared statements that asyncpg relies on by default). Note the
# username also changes format for the pooler: postgres.<project-ref>, not
# just postgres.
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxx:password@aws-0-<region>.pooler.supabase.com:5432/postgres

# Qdrant Cloud (https://cloud.qdrant.io) - there's no local Qdrant container;
# the backend always talks to a hosted cluster, in Docker Compose or not.
QDRANT_URL=https://xxxxxxxx.<region>.<provider>.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Model selection (safe to leave as defaults)
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_CONDENSE_MODEL=claude-haiku-4-5-20251001
